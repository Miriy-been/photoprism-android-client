<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <color android:color="?colorControlHighlight" />
    </item>

    <!-- 侘寂选中态 — 和紙底色 + 4dp 圆角 -->
    <item android:state_selected="true">
        <layer-list>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/wabi_corner_photo" />
                    <solid android:color="@color/wabi_accent_light" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
