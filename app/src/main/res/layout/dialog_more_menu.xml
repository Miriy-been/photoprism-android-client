<!-- 侘寂"更多"菜单 — 简化版：仅同步设置、自定义底部栏、偏好设置 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/wabi_spacing_sm"
    android:paddingBottom="@dimen/wabi_spacing_md">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/wabi_spacing_md"
        android:layout_marginBottom="@dimen/wabi_spacing_sm"
        android:text="@string/more"
        android:textAppearance="@style/TextAppearance.Wabi.Title3"
        android:textColor="@color/wabi_text_primary" />

    <!-- 同步设置 -->
    <LinearLayout
        android:id="@+id/more_sync_settings"
        style="@style/WabiMoreMenuItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            style="@style/WabiMoreMenuIcon"
            android:src="@drawable/ic_reorder" />

        <TextView
            style="@style/WabiMoreMenuText"
            android:text="@string/sync_settings" />
    </LinearLayout>

    <!-- 自定义底部菜单栏 -->
    <LinearLayout
        android:id="@+id/more_customize_nav"
        style="@style/WabiMoreMenuItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            style="@style/WabiMoreMenuIcon"
            android:src="@drawable/ic_menu" />

        <TextView
            style="@style/WabiMoreMenuText"
            android:text="@string/customize_bottom_nav_title" />
    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="@dimen/wabi_spacing_md"
        android:layout_marginVertical="@dimen/wabi_spacing_sm"
        android:background="@color/wabi_divider" />

    <!-- 偏好设置 -->
    <LinearLayout
        android:id="@+id/more_preferences"
        style="@style/WabiMoreMenuItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            style="@style/WabiMoreMenuIcon"
            android:src="@drawable/ic_gear" />

        <TextView
            style="@style/WabiMoreMenuText"
            android:text="@string/preferences" />
    </LinearLayout>

</LinearLayout>
