<?xml version="1.0" encoding="utf-8"?>
<!-- 侘寂底部导航栏布局 — 手机端 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".features.gallery.view.GalleryActivity">

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 照片网格原生内容（图库 Tab） -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/native_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/include_activity_gallery_content" />
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- Fragment 容器（其他 Tab） -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 侘寂底部导航栏 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/WabiBottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/default_navigation_bar_height"
        android:background="@color/wabi_bg_card"
        app:elevation="0dp"
        app:fabAnimationMode="scale"
        app:itemIconSize="20dp"
        app:itemPaddingBottom="4dp"
        app:itemPaddingTop="6dp"
        app:itemRippleColor="@color/wabi_accent_light"
        app:itemTextAppearanceActive="@style/TextAppearance.Wabi.Caption2"
        app:itemTextAppearanceInactive="@style/TextAppearance.Wabi.Caption2"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/gallery_bottom_nav" />

</LinearLayout>
