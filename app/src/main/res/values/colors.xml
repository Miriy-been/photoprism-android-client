<resources>
    <!-- ============================================================
         侘寂 Wabi-Sabi 色彩系统
         灵感：日系克制美学 — 和紙 · 藍鼠 · 炭灰 · 褪紅
         禁用：纯黑、渐变、高饱和、深色模式
         ============================================================ -->

    <!-- 基础色板 -->
    <color name="seed">#6B7E8A</color>

    <!-- 主色调：藍鼠（あいねず）— 克制的蓝灰 -->
    <color name="md_theme_light_primary">#6B7E8A</color>
    <color name="md_theme_light_onPrimary">#FFFFFF</color>
    <color name="md_theme_light_primaryContainer">#E8EDF0</color>
    <color name="md_theme_light_onPrimaryContainer">#3A3835</color>

    <!-- 次级色 -->
    <color name="md_theme_light_secondary">#8D8882</color>
    <color name="md_theme_light_onSecondary">#FFFFFF</color>
    <color name="md_theme_light_secondaryContainer">#F6F4EF</color>
    <color name="md_theme_light_onSecondaryContainer">#3A3835</color>

    <!-- 第三级色（同色系克制） -->
    <color name="md_theme_light_tertiary">#6B7E8A</color>
    <color name="md_theme_light_onTertiary">#FFFFFF</color>
    <color name="md_theme_light_tertiaryContainer">#E8EDF0</color>
    <color name="md_theme_light_onTertiaryContainer">#3A3835</color>

    <!-- 错误色：褪紅（あせべに）— 柔和的红棕 -->
    <color name="md_theme_light_error">#C1665B</color>
    <color name="md_theme_light_onError">#FFFFFF</color>
    <color name="md_theme_light_errorContainer">#FDF0EE</color>
    <color name="md_theme_light_onErrorContainer">#4A1C18</color>

    <!-- 表面/背景色 -->
    <color name="md_theme_light_background">#F6F4EF</color>   <!-- 和紙（わし）暖白底 -->
    <color name="md_theme_light_onBackground">#3A3835</color>  <!-- 炭灰（墨汁）文字 -->
    <color name="md_theme_light_surface">#FFFFFF</color>       <!-- 纯白卡片表面 -->
    <color name="md_theme_light_onSurface">#3A3835</color>
    <color name="md_theme_light_surfaceVariant">#E8E4DC</color><!-- 极淡暖灰（分割线） -->
    <color name="md_theme_light_onSurfaceVariant">#8D8882</color>
    <color name="md_theme_light_outline">#E8E4DC</color>       <!-- 边线 -->
    <color name="md_theme_light_inverseOnSurface">#F6F4EF</color>
    <color name="md_theme_light_inverseSurface">#3A3835</color>
    <color name="md_theme_light_inversePrimary">#6B7E8A</color>

    <!-- 语义别名（方便布局中直接引用） -->
    <color name="wabi_bg_base">@color/md_theme_light_background</color>
    <color name="wabi_bg_card">@color/md_theme_light_surface</color>
    <color name="wabi_divider">@color/md_theme_light_outline</color>
    <color name="wabi_accent">@color/md_theme_light_primary</color>
    <color name="wabi_accent_light">@color/md_theme_light_primaryContainer</color>
    <color name="wabi_text_primary">@color/md_theme_light_onBackground</color>
    <color name="wabi_text_secondary">@color/md_theme_light_onSurfaceVariant</color>
    <color name="wabi_error">@color/md_theme_light_error</color>
    <color name="wabi_chip_background">@color/md_theme_light_surfaceVariant</color>
    <color name="wabi_chip_stroke">@color/md_theme_light_outline</color>

    <!-- ============================================================
