root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
indent_size = 4
ij_kotlin_allow_trailing_comma = true
ij_kotlin_name_count_to_use_star_import = 999

[*.xml]
indent_size = 4

[*.yml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
